# Database URL (default: SQLite in data directory)
DATABASE_URL=sqlite+aiosqlite:///./data/finance.db

# Encryption key for storing credentials (REQUIRED)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Service ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# SimpleFIN: Get a setup token from https://bridge.simplefin.org
# Paste it into the app UI — no env var needed.

# Gemini (get key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
